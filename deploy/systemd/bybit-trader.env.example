# Safe systemd template: frozen public-data H4 Shadow only.
BOT_MODE=PAPER
BOT_API_HOST=127.0.0.1
BOT_API_PORT=8080
BOT_CONTROL_TOKEN=replace-with-operator-control-token
BOT_DATABASE_PATH=/var/lib/bybit-trader/bybit-trader.sqlite
BOT_SYMBOL=BTCUSDT
BOT_TIMEFRAMES=M1,M5,M15
BOT_VOLUME_FLOW_COMPOSITE_CONFIG_PATH=/opt/bybit-trader/current/config/volume-flow-composite-current.json
BOT_PAPER_LOOP_ENABLED=false

BOT_FORWARD_MARKET_CAPTURE_ENABLED=false
BYBIT_PUBLIC_WEBSOCKET_URL=wss://stream.bybit.com/v5/public/linear
BOT_FORWARD_ORDER_BOOK_DEPTH=50
BOT_FORWARD_RAW_ARCHIVE_ENABLED=false
BOT_FORWARD_RAW_ARCHIVE_PATH=/var/lib/bybit-trader/market-events
BOT_MAKER_SHADOW_ENABLED=false
BOT_MAKER_SHADOW_SESSION_ID=
BOT_MAKER_SHADOW_INITIAL_EQUITY=100
BOT_MAKER_SHADOW_ORDER_QUANTITY=0.001
BOT_MAKER_SHADOW_MAX_NOTIONAL=100
BOT_MAKER_SHADOW_QUEUE_MULTIPLIER=1.5
BOT_MAKER_SHADOW_QUEUE_BUFFER_QUANTITY=0
BOT_MAKER_SHADOW_MIN_SPREAD_BPS=0
BOT_MAKER_SHADOW_MAKER_FEE_RATE=0.0002
BOT_MAKER_SHADOW_TAKER_FEE_RATE=0.00055
BOT_MAKER_SHADOW_TAKER_EXIT_SLIPPAGE_BPS=2
BOT_MAKER_SHADOW_MAX_QUOTE_AGE_MILLIS=2000
BOT_MAKER_SHADOW_MAX_HOLDING_SECONDS=60
BOT_MAKER_SHADOW_MAX_EVENT_DELAY_MILLIS=1000

BOT_VOLUME_CONFIRMED_TREND_SHADOW_ENABLED=true
BOT_VOLUME_CONFIRMED_TREND_PROTOCOL_PATH=/opt/bybit-trader/current/config/volume-confirmed-trend-ensemble-v1.json
BOT_VOLUME_CONFIRMED_TREND_BOOTSTRAP_PATH=/opt/bybit-trader/current/config/volume-confirmed-trend-ensemble-v1-bootstrap.json
BOT_VOLUME_CONFIRMED_TREND_SHADOW_INITIAL_EQUITY=660
BOT_VOLUME_CONFIRMED_TREND_SHADOW_MAX_DELAY_SECONDS=1200
BOT_VOLUME_CONFIRMED_TREND_SHADOW_RECENT_SYNC_LIMIT=1000
BOT_VOLUME_CONFIRMED_TREND_SHADOW_HISTORY_PAGE_LIMIT=1000
BOT_VOLUME_CONFIRMED_TREND_SHADOW_MAX_HISTORY_REQUESTS=1000
BOT_VOLUME_CONFIRMED_TREND_SHADOW_BOUNDARY_DELAY_SECONDS=10
BOT_VOLUME_CONFIRMED_TREND_SHADOW_RETRY_SECONDS=60
BOT_VOLUME_CONFIRMED_TREND_LIVE_ENABLED=false
BOT_VOLUME_CONFIRMED_TREND_APPROVAL_EXPORT_DIR=/var/lib/bybit-trader/trend-approval
BOT_VOLUME_CONFIRMED_TREND_LIVE_APPROVAL_PATH=/opt/bybit-trader/current/config/volume-confirmed-trend-live-approval.json
BOT_VOLUME_CONFIRMED_TREND_SHADOW_EVIDENCE_PATH=/var/lib/bybit-trader/trend-approval/pending/shadow-evidence.json
BOT_VOLUME_CONFIRMED_TREND_APPROVAL_REPORT_PATH=/var/lib/bybit-trader/trend-approval/pending/approval-report.json

BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_PRIVATE_BASE_URL=https://api.bybit.com
BYBIT_PRIVATE_WEBSOCKET_URL=wss://stream.bybit.com/v5/private
BYBIT_RECV_WINDOW_MILLIS=5000
BYBIT_POSITION_IDX=0
BYBIT_ACCOUNT_TYPE=UNIFIED

BOT_PRIVATE_EXECUTION_ENABLED=false
BOT_PRIVATE_EXECUTION_STREAM_ENABLED=false
BOT_EXECUTION_LOOP_ENABLED=false
BOT_EXECUTION_RECONCILIATION_ENABLED=false
BOT_EXECUTION_RECONCILIATION_INTERVAL_SECONDS=60
BOT_EXECUTION_ALLOW_UNVERIFIED_PROFILE=false
BOT_EXECUTION_TIMEFRAME=M5
BOT_EXECUTION_CANDLE_LIMIT=18000
BOT_EXECUTION_SYNC_LIMIT=1000
BOT_EXECUTION_ALERT_BATCH_LIMIT=100
BOT_EXECUTION_INTERVAL_SECONDS=300
BOT_EXECUTION_ACCOUNT_EQUITY=660
BOT_EXECUTION_USE_LIVE_EQUITY=false
BOT_EXECUTION_RISK_FRACTION=0.055
BOT_EXECUTION_FEE_RATE=0.0006
BOT_EXECUTION_SLIPPAGE_BUFFER_RATE=0.0002
BOT_EXECUTION_QTY_STEP=0.001
BOT_EXECUTION_MIN_QTY=0.001
BOT_EXECUTION_MAX_QTY=
BOT_EXECUTION_MAX_NOTIONAL=100
BOT_EXECUTION_LEVERAGE=1
BOT_EXECUTION_LIQUIDATION_BUFFER_PCT=0.6
BOT_EXECUTION_MIN_NET_RR=1.0
BOT_EXECUTION_PRICE_TICK=0.1
BOT_EXECUTION_PROTECTION_GRACE_SECONDS=120

TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
DISCORD_ALERTS_ENABLED=false
DISCORD_WEBHOOK_URL=replace-with-discord-webhook-url
