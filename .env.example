# Runtime application environment template.
# Copy this file to .env for local runs. GitHub Actions deployment uses the
# matching onprem-live Environment secrets and variables to generate this file
# on the host.

BOT_MODE=LIVE
BOT_API_HOST=0.0.0.0
BOT_API_PORT=8080
BOT_CONTROL_TOKEN=replace-with-operator-control-token
BOT_DATABASE_PATH=/data/bybit-trader.sqlite
BOT_SYMBOL=BTCUSDT
BOT_TIMEFRAMES=M1,M5,M15
BOT_VOLUME_FLOW_COMPOSITE_CONFIG_PATH=/opt/bybit-trader/config/volume-flow-composite-current.json
BOT_STRATEGY_PROFILE_STATE_PATH=/data/strategy-profile-current.txt

# Forward-only causal paper execution. This candidate is UNVERIFIED and cannot submit private orders.
BOT_PAPER_LOOP_ENABLED=false
BOT_PAPER_STRATEGY=multi-horizon-momentum
BOT_PAPER_TIMEFRAME=M5
BOT_PAPER_CANDLE_LIMIT=12000
BOT_PAPER_SYNC_LIMIT=1000
BOT_PAPER_INTERVAL_SECONDS=300
BOT_PAPER_INITIAL_EQUITY=1000000
BOT_PAPER_RISK_FRACTION=0.01
BOT_PAPER_FEE_RATE=0.0006

# Forward-only public data collection for future research. It does not submit orders or alter strategy evaluation.
BOT_FORWARD_MARKET_CAPTURE_ENABLED=false
BYBIT_PUBLIC_WEBSOCKET_URL=wss://stream.bybit.com/v5/public/linear
BOT_FORWARD_ORDER_BOOK_DEPTH=50
BOT_FORWARD_RAW_ARCHIVE_ENABLED=false
BOT_FORWARD_RAW_ARCHIVE_PATH=/data/market-events

# Event-sequence maker research. This writes simulated events only and never submits an exchange order.
BOT_MAKER_SHADOW_ENABLED=false
BOT_MAKER_SHADOW_SESSION_ID=
BOT_MAKER_SHADOW_INITIAL_EQUITY=100
BOT_MAKER_SHADOW_ORDER_QUANTITY=0.001
BOT_MAKER_SHADOW_MAX_NOTIONAL=100
BOT_MAKER_SHADOW_QUEUE_MULTIPLIER=1.5
BOT_MAKER_SHADOW_QUEUE_BUFFER_QUANTITY=0
BOT_MAKER_SHADOW_MIN_SPREAD_BPS=0
# Replace these defaults with the account's actual Bybit fee rates before collecting approval evidence.
BOT_MAKER_SHADOW_MAKER_FEE_RATE=0.0002
BOT_MAKER_SHADOW_TAKER_FEE_RATE=0.00055
BOT_MAKER_SHADOW_TAKER_EXIT_SLIPPAGE_BPS=2
BOT_MAKER_SHADOW_MAX_QUOTE_AGE_MILLIS=2000
BOT_MAKER_SHADOW_MAX_HOLDING_SECONDS=60
BOT_MAKER_SHADOW_MAX_EVENT_DELAY_MILLIS=1000

# Frozen H4 trend forward validation. This is a virtual position ledger and never submits an exchange order.
BOT_VOLUME_CONFIRMED_TREND_SHADOW_ENABLED=false
BOT_VOLUME_CONFIRMED_TREND_PROTOCOL_PATH=/opt/bybit-trader/config/volume-confirmed-trend-ensemble-v1.json
BOT_VOLUME_CONFIRMED_TREND_BOOTSTRAP_PATH=/opt/bybit-trader/config/volume-confirmed-trend-ensemble-v1-bootstrap.json
BOT_VOLUME_CONFIRMED_TREND_SHADOW_INITIAL_EQUITY=660
BOT_VOLUME_CONFIRMED_TREND_SHADOW_MAX_DELAY_SECONDS=1200
BOT_VOLUME_CONFIRMED_TREND_SHADOW_RECENT_SYNC_LIMIT=1000
BOT_VOLUME_CONFIRMED_TREND_SHADOW_HISTORY_PAGE_LIMIT=1000
BOT_VOLUME_CONFIRMED_TREND_SHADOW_MAX_HISTORY_REQUESTS=1000
BOT_VOLUME_CONFIRMED_TREND_SHADOW_BOUNDARY_DELAY_SECONDS=10
BOT_VOLUME_CONFIRMED_TREND_SHADOW_RETRY_SECONDS=60

BYBIT_API_KEY=replace-with-bybit-api-key
BYBIT_API_SECRET=replace-with-bybit-api-secret
BYBIT_PRIVATE_BASE_URL=https://api.bybit.com
BYBIT_PRIVATE_WEBSOCKET_URL=wss://stream.bybit.com/v5/private
BYBIT_RECV_WINDOW_MILLIS=5000
BYBIT_POSITION_IDX=0
BYBIT_ACCOUNT_TYPE=UNIFIED

BOT_PRIVATE_EXECUTION_ENABLED=true
# Private execution events wake REST reconciliation immediately; REST remains the recovery path.
BOT_PRIVATE_EXECUTION_STREAM_ENABLED=true
BOT_EXECUTION_LOOP_ENABLED=false
BOT_EXECUTION_RECONCILIATION_ENABLED=true
BOT_EXECUTION_RECONCILIATION_INTERVAL_SECONDS=60
# Legacy TESTNET-only override for future UNVERIFIED candidates. It cannot enable the current REJECTED profile.
BOT_EXECUTION_ALLOW_UNVERIFIED_PROFILE=false
BOT_EXECUTION_TIMEFRAME=M5
# Automatic trading evaluates fully closed candles only. Reconciliation runs independently.
BOT_EXECUTION_CANDLE_LIMIT=18000
BOT_EXECUTION_SYNC_LIMIT=1000
BOT_EXECUTION_ALERT_BATCH_LIMIT=100
BOT_EXECUTION_INTERVAL_SECONDS=300
BOT_EXECUTION_ACCOUNT_EQUITY=660
BOT_EXECUTION_USE_LIVE_EQUITY=true
BOT_EXECUTION_RISK_FRACTION=0.055
BOT_EXECUTION_FEE_RATE=0.0006
BOT_EXECUTION_SLIPPAGE_BUFFER_RATE=0.0002
BOT_EXECUTION_QTY_STEP=0.001
BOT_EXECUTION_MIN_QTY=0.001
BOT_EXECUTION_MAX_QTY=
BOT_EXECUTION_MAX_NOTIONAL=100
BOT_EXECUTION_LEVERAGE=15
BOT_EXECUTION_LIQUIDATION_BUFFER_PCT=0.6
BOT_EXECUTION_MIN_NET_RR=1.0
BOT_EXECUTION_PRICE_TICK=0.1
# Reconciliation must confirm actual-fill TP/SL before this deadline or the automatic position is closed reduce-only.
BOT_EXECUTION_PROTECTION_GRACE_SECONDS=120
BOT_EXECUTION_MAX_ENTRY_DELAY_SECONDS=30
BOT_EXECUTION_MAX_ACTUAL_RISK_OVERRUN_FRACTION=0.05
BOT_EXECUTION_SAFETY_VERIFICATION_ATTEMPTS=5
BOT_EXECUTION_SAFETY_VERIFICATION_INTERVAL_MILLIS=250
# Fail closed before new entries when account equity state is missing, stale, or breaches a loss limit.
BOT_EXECUTION_CIRCUIT_BREAKER_ENABLED=true
BOT_EXECUTION_MAX_DAILY_LOSS_FRACTION=0.03
BOT_EXECUTION_MAX_ACCOUNT_DRAWDOWN_FRACTION=0.20
BOT_EXECUTION_MAX_CONSECUTIVE_LOSSES=3
BOT_EXECUTION_RISK_STATE_MAX_AGE_SECONDS=120
# New entries stay blocked until USDT wallet changes match the persisted Bybit transaction log.
BOT_EXECUTION_WALLET_RECONCILIATION_ENABLED=true
BOT_EXECUTION_WALLET_RECONCILIATION_TOLERANCE=0.01
BOT_EXECUTION_WALLET_RECONCILIATION_MAX_AGE_SECONDS=180
BOT_EXECUTION_WALLET_RECONCILIATION_CONFIRMED_MISMATCHES=3

TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id
DISCORD_ALERTS_ENABLED=false
DISCORD_WEBHOOK_URL=replace-with-discord-webhook-url
